# Tencent Cloud CCR registry host and full image path.
# Configure these values as GitHub Environment Variables for deploy.yml.
DOCKER_REGISTRY=ccr.ccs.tencentyun.com
DOCKER_IMAGE_NAME=ccr.ccs.tencentyun.com/tsuz/tsuz-web-admin-test
DOCKER_REGISTRY_USERNAME=__TCR_ACCOUNT_ID__

# Deployment target values. Keep real server values in GitHub Environment Variables.
DEPLOY_HOST=__DEPLOY_HOST__
DEPLOY_PORT=22
DEPLOY_USER=__DEPLOY_USER__
DEPLOY_PATH=/opt/tsuz-web-admin/runtime

# The deployment server checks out release tags here and builds the image.
# This must be a dedicated source directory separate from DEPLOY_PATH.
DEPLOY_REPO_PATH=/opt/tsuz-web-admin/source
DOCKER_BUILD_PLATFORM=linux/amd64

# Immutable image/application version tag.
APP_VERSION=test-v1.0.0

# Container and host port settings.
CONTAINER_NAME=tsuz-web-admin
APP_PORT=7201

# Deployment environment and Vite build-time variables.
APP_ENV=test
VITE_API_BASE_URL=https://test-api.tusz.online
VITE_PUBLIC_BASE=/subapps/admin/

# The following values are GitHub Actions Secrets and are not required by
# docker compose at runtime. Never commit their real values here:
# DOCKER_REGISTRY_TOKEN=__CCR_TOKEN__
# SSH_PRIVATE_KEY=__SSH_PRIVATE_KEY__
# SSH_KNOWN_HOSTS=__SSH_KNOWN_HOSTS__
